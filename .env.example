# ============================================================
# El Patio SIG — Variables de entorno (copiar a .env y completar)
# NUNCA commitear el .env real. Este archivo es la plantilla.
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-por-una-clave-secreta-larga-y-aleatoria
# DEBUG=True SOLO en desarrollo. En producción DEBE ser False
# (config/settings/prod.py lo prohíbe con un assert).
DJANGO_DEBUG=True
# En producción completar con el/los dominio/s reales, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DEV: config.settings.dev | PROD: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Base de datos (DEV usa SQLite por defecto; PROD usa PostgreSQL)
# DB_ENGINE: sqlite | postgres
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Seguridad en producción (se leen desde config/settings/prod.py)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS=True
DJANGO_COOKIE_SECURE=True
# Orígenes confiables para CSRF (solo si frontend y backend están en dominios
# distintos; ej: https://elpatio.com,https://admin.elpatio.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Correo (obligatorio en PROD: reset de password y alertas a ADMINS)
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_SERVER_EMAIL=no-reply@elpatio.local
# Administradores que reciben mails de errores 5xx, separados por coma
DJANGO_ADMINS=

# Directorio de logs (rotación automática de 5 MB x 5)
DJANGO_LOG_DIR=logs

# SOLO para demos puntuales: permitir SQLite en settings.prod.
# NO usar en un despliegue real.
# FORCE_SQLITE_IN_PROD=True
